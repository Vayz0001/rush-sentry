#!/usr/bin/env bash
# toolkit — rush-sentry entrypoint.
# One CLI, subcommands, machine-readable output. Contract is frozen after 1.0:
# additive changes only; exit-code meanings never change.
#
# Exit codes:  0 ok · 1 error · 2 auth · 3 input/validation · 4 confirm-required
set -euo pipefail

VERSION="0.1.0"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PROG="toolkit"

# stdout = machine channel; stderr = human/errors.
err()  { printf '%s\n' "$*" >&2; }
die()  { err "error: $*"; exit 1; }
# JSON error on stderr for agents; $1=code string $2=message
jerr() { printf '{"error":%s,"code":%s}\n' "$(jq -Rn --arg m "$2" '$m')" "$(jq -Rn --arg c "$1" '$c')" >&2; }

usage() {
  cat <<EOF
$PROG $VERSION — rush-sentry BYOCli security toolkit

USAGE:
  $PROG <command> [options]

COMMANDS:
  scan <tool|all>    Run security scanners (secrets|deps|sast|iac|ci|sbom|all)
                     --target <path>   path to scan (default: .)
                     --format <fmt>    sarif|json  (default: sarif)
  lab <action>       Manage the isolated vulnerable-app lab (up|down|status|verify)
                     up --attacker     also pre-pull the attacker toolbox
  lab attack <tool>  Run an airgapped attacker tool against the lab
                     (nuclei|httpx|katana|ffuf|sqlmap|schemathesis|zap) -- <args>
  notify <action>    Threat-intel: run|test  (CISA KEV ∩ deps -> webhook)
  manifest           Print scanners/MANIFEST.json (the machine-readable catalog)
  version            Print version
  help               Show this help

Defensive / authorized use only. See AGENTS.md and SECURITY.md.
Unknown commands hard-fail (no fuzzy matching) so an agent can't act on a guess.
EOF
}

# Tools that make up "scan all", in order.
SCAN_ALL="secrets deps sast iac ci"

cmd_scan() {
  local tool="${1:-}"; shift || true
  [[ -n "$tool" ]] || { jerr "input" "scan requires a tool: $SCAN_ALL sbom all"; exit 3; }
  local target="." format="sarif"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target) target="${2:?--target needs a value}"; shift 2;;
      --format) format="${2:?--format needs a value}"; shift 2;;
      *) jerr "input" "unknown flag: $1"; exit 3;;
    esac
  done
  [[ -d "$target" || -f "$target" ]] || { jerr "input" "target not found: $target"; exit 3; }

  if [[ "$tool" == "all" ]]; then scan_all "$target" "$format"; return; fi

  local runner="$ROOT/scanners/$tool/run.sh"
  [[ -x "$runner" ]] || { jerr "input" "unknown or unwired tool: $tool"; exit 3; }
  exec "$runner" --target "$target" --format "$format"
}

# Run every scanner, save each SARIF, merge into one, print combined to stdout
# and a human summary to stderr.
scan_all() {
  local target="$1" format="$2"
  local outdir="$ROOT/reports"; mkdir -p "$outdir"
  local merged="$outdir/combined.sarif" t rc
  local -a ok=() failed=()
  for t in $SCAN_ALL; do
    local runner="$ROOT/scanners/$t/run.sh"
    [[ -x "$runner" ]] || { failed+=("$t:unwired"); continue; }
    err "[$PROG] scanning: $t ..."
    if "$runner" --target "$target" --format sarif > "$outdir/$t.sarif" 2> "$outdir/$t.err"; then
      ok+=("$t")
    else
      rc=$?; failed+=("$t:exit$rc")
      err "[$PROG]   $t failed (exit $rc) — see reports/$t.err"
    fi
  done
  # Merge valid SARIF files (skip empties) into one multi-run document.
  local -a files=()
  for t in "${ok[@]:-}"; do [[ -s "$outdir/$t.sarif" ]] && files+=("$outdir/$t.sarif"); done
  if [[ ${#files[@]} -gt 0 ]]; then
    jq -s 'reduce .[] as $f ({ "$schema":"https://json.schemastore.org/sarif-2.1.0.json", version:"2.1.0", runs:[] }; .runs += ($f.runs // [])) ' "${files[@]}" > "$merged"
  else
    # shellcheck disable=SC2016  # literal $schema in JSON, intentional
    printf '{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","version":"2.1.0","runs":[]}\n' > "$merged"
  fi
  # Enrich the merged report: add security-severity bands + dedup fingerprints.
  if [[ -f "$ROOT/scanners/lib/enrich_sarif.py" ]]; then
    if python3 "$ROOT/scanners/lib/enrich_sarif.py" < "$merged" > "$merged.tmp" 2>/dev/null; then
      mv "$merged.tmp" "$merged"
    else
      rm -f "$merged.tmp"
    fi
  fi
  # Summary to stderr.
  local total; total=$(jq '[.runs[].results[]?] | length' "$merged")
  err "[$PROG] scan all complete — ran: ${ok[*]:-none}; failed: ${failed[*]:-none}; findings: $total"
  err "[$PROG] combined report: $merged"
  cat "$merged"
}

LAB_COMPOSE="$ROOT/lab/docker-compose.yml"
LAB_PROJECT="rush-sentry-lab"
LAB_NET="rush_sentry_labnet"

cmd_lab() {
  local action="${1:-}"; shift || true
  [[ -f "$LAB_COMPOSE" ]] || { jerr error "lab compose not found: $LAB_COMPOSE" 1; }
  command -v docker >/dev/null || jerr error "docker is required" 1
  local -a dc=(docker compose -p "$LAB_PROJECT" -f "$LAB_COMPOSE")
  case "$action" in
    up)
      err "[$PROG] lab: pulling + starting targets (first run pulls images, be patient) ..."
      if [[ "${1:-}" == "--attacker" ]]; then
        err "[$PROG] pre-pulling attacker toolbox images ..."; "${dc[@]}" --profile attacker pull >&2 || true
      fi
      "${dc[@]}" up -d >&2
      lab_verify
      err "[$PROG] lab up. Targets (loopback only):"
      err "    Juice Shop  http://127.0.0.1:3000"
      err "    DVWA        http://127.0.0.1:8080   (admin/password; setup -> Create/Reset DB)"
      err "    VAmPI       http://127.0.0.1:5000"
      ;;
    down)   "${dc[@]}" down >&2; err "[$PROG] lab down.";;
    status) "${dc[@]}" ps;;
    verify) lab_verify;;
    attack)
      local tool="${1:-}"; shift || true
      [[ -n "$tool" ]] || { jerr input "lab attack needs a tool + args: nuclei|httpx|katana|ffuf|sqlmap|schemathesis|zap -- <args>" 3; return 3; }
      err "[$PROG] ⚔️  Attacker toolbox: airgapped to the bundled lab (no internet route)."
      err "[$PROG]     Authorized/defensive use only. Targets: juice-shop:3000 · dvwa · vampi:5000"
      "${dc[@]}" --profile attacker run --rm "$tool" "$@"
      ;;
    *) jerr input "lab needs an action: up|down|status|verify|attack" 3;;
  esac
}

# Prove the airgap: a throwaway container on the lab network must NOT reach the
# internet. Reports BLOCKED (good) or LEAK (bad — stop and fix isolation).
lab_verify() {
  docker network inspect "$LAB_NET" >/dev/null 2>&1 || { err "[$PROG] lab network not up yet."; return 0; }
  local res
  res="$(docker run --rm --network "$LAB_NET" alpine:latest \
          sh -c 'wget -T3 -q -O- https://example.com >/dev/null 2>&1 && echo LEAK || echo BLOCKED' 2>/dev/null || echo BLOCKED)"
  if [[ "$res" == "BLOCKED" ]]; then
    err "[$PROG] airgap verified: lab has NO outbound internet (BLOCKED ✓)"
  else
    err "[$PROG] ⚠️  AIRGAP FAILURE: lab reached the internet (LEAK). Do not use — check that labnet is internal:true."
    return 1
  fi
}

cmd_notify() {
  local action="${1:-}"; shift || true
  local watcher="$ROOT/notify/watch.py"
  [[ -f "$watcher" ]] || { jerr error "notify watcher missing: $watcher" 1; }
  command -v python3 >/dev/null || jerr error "python3 is required" 1
  case "$action" in
    run)  exec python3 "$watcher" "$@";;          # --target, --dry-run passthrough
    test) exec python3 "$watcher" --test;;
    *) jerr input "notify needs an action: run|test (run takes --target PATH, --dry-run)" 3;;
  esac
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    scan)     cmd_scan "$@";;
    lab)      cmd_lab "$@";;
    notify)   cmd_notify "$@";;
    manifest) cat "$ROOT/scanners/MANIFEST.json";;
    version|--version|-V) printf '%s %s\n' "$PROG" "$VERSION";;
    help|--help|-h) usage;;
    *) jerr "input" "unknown command: $cmd (try '$PROG help')"; exit 3;;
  esac
}
main "$@"
